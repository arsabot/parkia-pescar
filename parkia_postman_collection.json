{
  "info": {
    "name": "PARKIA - Login & Auth API",
    "description": "Colección de endpoints de autenticación y login para PARKIA",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Demo Login (Conductor)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData && jsonData.tokens && jsonData.tokens.access) {",
              "    pm.collectionVariables.set('access_token', jsonData.tokens.access);",
              "    console.log('Token JWT guardado automáticamente en access_token');",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"role\": \"driver\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/demo-login/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "demo-login",
            ""
          ]
        }
      }
    },
    {
      "name": "2. Registro de Usuario",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData && jsonData.tokens && jsonData.tokens.access) {",
              "    pm.collectionVariables.set('access_token', jsonData.tokens.access);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"first_name\": \"Ariel\",\n  \"last_name\": \"Developer\",\n  \"email\": \"ariel@parkia.com\",\n  \"password\": \"Password123\",\n  \"password_confirmation\": \"Password123\",\n  \"role\": \"driver\",\n  \"phone\": \"+5491122334455\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/register/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "register",
            ""
          ]
        }
      }
    },
    {
      "name": "3. Iniciar Sesión (Login)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData && jsonData.tokens && jsonData.tokens.access) {",
              "    pm.collectionVariables.set('access_token', jsonData.tokens.access);",
              "    console.log('Token JWT guardado automáticamente en access_token');",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"ariel@parkia.com\",\n  \"password\": \"Password123\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/login/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "login",
            ""
          ]
        }
      }
    },
    {
      "name": "4. Obtener Perfil (/api/auth/me/)",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/auth/me/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "me",
            ""
          ]
        }
      }
    },
    {
      "name": "5. Refrescar Token JWT",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refresh\": \"PEGA_AQUI_TU_REFRESH_TOKEN\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/token/refresh/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "token",
            "refresh",
            ""
          ]
        }
      }
    }
  ]
}
